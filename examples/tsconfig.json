{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./lib",
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "incremental": true,
    "composite": true
  },
  "ts-node": {
    "files": true,
    "compilerOptions": {
      "module": "es2015"
    }
  },
  "include": ["./mcp/new-server.ts", "./mcp/client.ts"],
  "exclude": [
    "dist",
    "models/openai/live/browser/open-ai-realtime",
    "**/browser/**"
  ]
}
