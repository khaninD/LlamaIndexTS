{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./lib",
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "incremental": true,
    "composite": true
  },
  "ts-node": {
    "files": true,
    "compilerOptions": {
      "module": "es2015"
    }
  },
  "include": [
    "./mcp/new-server.ts",
    "./mcp/client.ts",
    "./mcp/pg-server.ts",
    "./mcp/pg-server-new.ts",
    "./mcp/llama-client.ts",
    "mcp/pg-foreign-mcp.ts",
    "./mcp/llm-logger.ts"
  ],
  "exclude": [
    "dist",
    "models/openai/live/browser/open-ai-realtime",
    "**/browser/**"
  ]
}
